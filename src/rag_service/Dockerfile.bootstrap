# syntax=docker/dockerfile:1.6

ARG RAG_RUNTIME_IMAGE=rag-service:latest
FROM ${RAG_RUNTIME_IMAGE}

USER root

RUN install -d -m 0755 -o 10001 -g 10001 \
      /app/data/raw/manuals \
      /app/data/raw/procedures \
      /app/data/raw/incidents \
      /app/data/processed/texts \
      /app/data/processed/manifest

COPY --chown=10001:10001 data/raw/ /app/data/raw/

USER appuser:appgroup

ENV PYTHONPATH=/app/src

CMD ["python", "-m", "rag_service.bootstrap_phase11"]
