# ----------------------------
# Embeddings (Phase 2 default)
# ----------------------------
# Use a local, production-grade embedding model (no paid API).
EMBEDDING_PROVIDER=bge
BGE_MODEL_NAME=BAAI/bge-large-en-v1.5

# Optional: OpenAI embeddings (only if you explicitly switch provider)
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=replace_me
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# ----------------------------
# LLM serving profile
# ----------------------------
# Use the same key for OPENAI_API_KEY and LLM_OPENAI_API_KEY when using OpenAI.
# Keep real secrets only in your local .env or secret manager.
OPENAI_API_KEY=replace_me
LLM_OPENAI_API_KEY=replace_me
LLM_PRIMARY_PROVIDER=openai
LLM_FALLBACK_PROVIDER=ollama

# Interactive root-cause/remediation queries should use a fast structured-output model.
# Heavier GPT-5 class models are better reserved for offline judging unless you have
# measured that they satisfy your latency SLO in your account/region.
LLM_OPENAI_MODEL=gpt-4.1-mini
LLM_OPENAI_JUDGE_MODEL=gpt-4.1-mini
LLM_MAX_TOKENS=700
LLM_REQUEST_TIMEOUT_S=30

# Bounded context keeps live RAG calls responsive without disabling retrieval quality.
# The fast path uses /retrieve/procedures/direct, a lexical lookup over real Markdown
# procedures, before falling back to semantic retrieval for ambiguous cases.
ROOT_CAUSE_FAST_PATH_ENABLED=true
ROOT_CAUSE_MAX_CONTEXT_DOCS=4
ROOT_CAUSE_MAX_CHARS_PER_DOC=1600
OUTPUT_GUARDRAILS_DETERMINISTIC_GROUNDEDNESS_THRESHOLD=0.35

# Groundedness judge policy:
# fallback = deterministic pass/fail first, LLM judge only for inconclusive cases.
# audit = still run a real LLM judge after deterministic pass for LangSmith evidence.
# strict = deterministic pass and LLM judge must both pass.
# off = no LLM judge; deterministic/lexical checks only.
OUTPUT_GUARDRAILS_LLM_JUDGE_MODE=fallback
OUTPUT_GUARDRAILS_LLM_JUDGE_PROVIDER=openai

# Per-client request limits. Keep these explicit so Phase 11 can load-test many
# simulated clients while still proving 429 enforcement for one noisy client.
ORCHESTRATOR_QUERY_RATE_LIMIT=90/minute
ORCHESTRATOR_FEEDBACK_RATE_LIMIT=20/minute

# Keep the pinned Ragas/LangChain stack on a broadly compatible judge by default.
# You can manually test gpt-5.4-mini for offline judging after confirming your
# installed evaluation stack does not send unsupported request parameters.
RAGAS_JUDGE_MODEL=gpt-4.1-mini
RAGAS_EMBEDDING_MODEL=text-embedding-3-small


# ----------------------------
# Qdrant
# ----------------------------
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=only_if_using_cloud


# ----------------------------
# Postgres (local docker-compose defaults)
# ----------------------------
POSTGRES_DSN=postgresql+psycopg://irc:irc_password@localhost:5432/industrial_maintenance

# Per-worker telemetry DB pool sizing. Keep this bounded because docker-compose
# runs multiple Uvicorn workers and Phase 11 includes bursty rate-limit drills.
TELEMETRY_DB_POOL_SIZE=5
TELEMETRY_DB_MAX_OVERFLOW=5
TELEMETRY_DB_POOL_TIMEOUT_S=10

# API gateway proxy pool. The Phase 11 load test runs 250 concurrent client
# tasks, so the gateway's downstream pool must be sized above that ceiling.
GATEWAY_MAX_CONNECTIONS=300
GATEWAY_MAX_KEEPALIVE_CONNECTIONS=100
GATEWAY_REQUEST_TIMEOUT_S=600
GATEWAY_CONNECT_TIMEOUT_S=10
GATEWAY_POOL_TIMEOUT_S=30


# ----------------------------
# Chunking / Ingestion tuning
# ----------------------------
# These are optional overrides; your code has good defaults already.
# CHUNK_SIZE_TOKENS=700
# CHUNK_OVERLAP_TOKENS=80
# EMBED_BATCH_SIZE=64
# UPSERT_BATCH_SIZE=128

# ----------------------------
# Logging
# ----------------------------
# LOG_LEVEL=INFO
HTTPX_LOG_LEVEL=WARNING
HTTPCORE_LOG_LEVEL=WARNING
PRESIDIO_LOG_LEVEL=ERROR

