{
  "title": "LLM Cost & Token Usage",
  "tags": ["production", "finops"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "10s",
  "panels": [
    {
      "title": "Token Usage (Actual LLM Calls Only)", "type": "timeseries", "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": { "defaults": { "custom": { "fillOpacity": 80, "stacked": true } } },
      "targets": [
        {"expr": "sum(increase(llm_tokens_total{token_type=\"input\"}[$__range])) OR on() vector(0)", "legendFormat": "input tokens"},
        {"expr": "sum(increase(llm_tokens_total{token_type=\"output\"}[$__range])) OR on() vector(0)", "legendFormat": "output tokens"}
      ]
    },
    {
      "title": "Estimated LLM Cost Per Completed Query ($)", "type": "stat", "gridPos": { "h": 9, "w": 8, "x": 16, "y": 0 },
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 } },
      "targets": [{"expr": "(((sum(increase(llm_tokens_total{provider=\"openai\",model=\"gpt-4.1-mini\",token_type=\"input\"}[$__range])) * 0.40 / 1000000) + (sum(increase(llm_tokens_total{provider=\"openai\",model=\"gpt-4.1-mini\",token_type=\"output\"}[$__range])) * 1.60 / 1000000)) / clamp_min(sum(increase(orchestrator_inference_path_total[$__range])), 1)) OR on() vector(0)"}]
    },
    {
      "title": "Estimated Daily OpenAI Cost", "type": "stat", "gridPos": { "h": 7, "w": 12, "x": 0, "y": 9 },
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 } },
      "targets": [{"expr": "((sum(increase(llm_tokens_total{provider=\"openai\",model=\"gpt-4.1-mini\",token_type=\"input\"}[24h])) * 0.40 / 1000000) + (sum(increase(llm_tokens_total{provider=\"openai\",model=\"gpt-4.1-mini\",token_type=\"output\"}[24h])) * 1.60 / 1000000)) OR on() vector(0)"}]
    },
    {
      "title": "Fast-Path Share", "type": "gauge", "gridPos": { "h": 7, "w": 6, "x": 12, "y": 9 },
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 2 } },
      "targets": [{"expr": "(sum(increase(orchestrator_inference_path_total{provider=\"rules+retrieval\"}[$__range])) / clamp_min(sum(increase(orchestrator_inference_path_total[$__range])), 1)) OR on() vector(0)"}]
    },
    {
      "title": "Query Cache Hit Rate", "type": "gauge", "gridPos": { "h": 7, "w": 6, "x": 18, "y": 9 },
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 2 } },
      "targets": [{"expr": "(sum(increase(cache_events_total{status=\"hit\"}[$__range])) / clamp_min(sum(increase(cache_events_total[$__range])), 1)) OR on() vector(0)"}]
    }
  ]
}
