{
  "title": "RAG Quality Metrics",
  "tags": ["production", "rag", "quality"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "10s",
  "panels": [
    {
      "title": "Online Groundedness Proxy (Range Avg)", "type": "gauge", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 2 } },
      "targets": [{"expr": "(sum(increase(llm_faithfulness_sum[$__range])) / clamp_min(sum(increase(llm_faithfulness_count[$__range])), 1)) OR on() vector(0)", "legendFormat": "Average Groundedness"}]
    },
    {
      "title": "Online Answer Relevancy Proxy (Range Avg)", "type": "gauge", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 2 } },
      "targets": [{"expr": "(sum(increase(llm_answer_relevancy_sum[$__range])) / clamp_min(sum(increase(llm_answer_relevancy_count[$__range])), 1)) OR on() vector(0)", "legendFormat": "Average Relevancy"}]
    },
    {
      "title": "Retrieved Evidence Count (Average)", "type": "gauge", "gridPos": { "h": 7, "w": 8, "x": 0, "y": 8 },
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": { "defaults": { "min": 0, "max": 5, "decimals": 1 } },
      "targets": [{"expr": "(sum(increase(retrieved_context_count_sum[$__range])) / clamp_min(sum(increase(retrieved_context_count_count[$__range])), 1)) OR on() vector(0)", "legendFormat": "Average Evidence Count"}]
    },
    {
      "title": "User Feedback Ratings (Selected Range)", "type": "bargauge", "gridPos": { "h": 7, "w": 8, "x": 8, "y": 8 },
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0 } },
      "targets": [
        {"expr": "sum(increase(user_feedback_total{rating=\"positive\"}[$__range])) OR on() vector(0)", "legendFormat": "positive"},
        {"expr": "sum(increase(user_feedback_total{rating=\"neutral\"}[$__range])) OR on() vector(0)", "legendFormat": "neutral"},
        {"expr": "sum(increase(user_feedback_total{rating=\"negative\"}[$__range])) OR on() vector(0)", "legendFormat": "negative"}
      ]
    },
    {
      "title": "Guardrail Blocks by Type (Selected Range)", "type": "bargauge", "gridPos": { "h": 7, "w": 8, "x": 16, "y": 8 },
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": { "defaults": { "min": 0, "decimals": 0 } },
      "targets": [
        {"expr": "sum(increase(orchestrator_guardrail_failures_total{type=\"input_validation\"}[$__range])) OR on() vector(0)", "legendFormat": "input_validation"},
        {"expr": "sum(increase(orchestrator_guardrail_failures_total{type=\"output_hallucination\"}[$__range])) OR on() vector(0)", "legendFormat": "output_hallucination"}
      ]
    }
  ]
}
