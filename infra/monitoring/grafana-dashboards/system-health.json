{
  "title": "System Health - LLM Orchestrator",
  "tags": ["production", "orchestrator"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "10s",
  "panels": [
    {
      "title": "Completed Query Throughput (req/s)", "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "decimals": 3 } },
      "targets": [{"expr": "sum(rate(orchestrator_inference_path_total[$__rate_interval])) OR on() vector(0)", "legendFormat": "completed queries"}]
    },
    {
      "title": "Completed Query Latency (P50, P95, P99)", "type": "timeseries", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "decimals": 3 } },
      "targets": [
        {"expr": "histogram_quantile(0.99, sum(rate(orchestrator_query_latency_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "P99"},
        {"expr": "histogram_quantile(0.95, sum(rate(orchestrator_query_latency_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "P95"},
        {"expr": "histogram_quantile(0.50, sum(rate(orchestrator_query_latency_seconds_bucket[$__rate_interval])) by (le))", "legendFormat": "P50"}
      ]
    },
    {
      "title": "Error Rate (5xx)", "type": "gauge", "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "(sum(rate(orchestrator_requests_total{endpoint=~\"/query.*\",http_status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(orchestrator_requests_total{endpoint=~\"/query.*\"}[$__rate_interval])), 0.001)) OR on() vector(0)"}]
    },
    {
      "title": "Active Service Targets", "type": "stat", "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(up) by (job)", "legendFormat": "{{job}}"}]
    },
    {
      "title": "Completed Queries", "type": "stat", "gridPos": { "h": 6, "w": 6, "x": 12, "y": 8 },
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": { "defaults": { "decimals": 0 } },
      "targets": [{"expr": "sum(increase(orchestrator_inference_path_total[$__range])) OR on() vector(0)", "legendFormat": "queries"}]
    }
  ]
}
